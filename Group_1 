        "# --- STEP 4: GRADIO INTERFACE DEPLOYMENT ---\n",
        "\n",
        "# Define the path to your fine-tuned model\n",
        "MODEL_DIR = \"./final_t5_summarizer_project\"\n",
        "\n",
        "# Use the Hugging Face pipeline for simplified, robust inference\n",
        "try:\n",
        "    # Attempt to load the fine-tuned model\n",
        "    summarizer_pipeline = transformers.pipeline(\n",
        "        \"summarization\",\n",
        "        model=MODEL_DIR,\n",
        "        tokenizer=MODEL_DIR,\n",
        "        device=0 if torch.cuda.is_available() else -1\n",
        "    )\n",
        "    title_text = \"Fine-Tuned T5-small Summarizer Demo (cnn_dailymail)\"\n",
        "except Exception as e:\n",
        "    print(f\"Could not load fine-tuned model ({e}). Falling back to a pre-trained base model.\")\n",
        "    # Fallback: Load the original t5-small model\n",
        "    summarizer_pipeline = transformers.pipeline(\n",
        "        \"summarization\",\n",
        "        model=\"t5-small\",\n",
        "        device=0 if torch.cuda.is_available() else -1\n",
        "    )\n",
        "    title_text = \"Base T5-small Summarizer Demo (Training may have failed)\"\n",
        "\n",
        "# Define the prediction function for Gradio\n",
        "def generate_summary_gradio(text):\n",
        "    if not text:\n",
        "        return \"Please paste a document to summarize.\"\n",
        "\n",
        "    # The pipeline handles all preprocessing, prefixing, and generation\n",
        "    result = summarizer_pipeline(\n",
        "        text,\n",
        "        max_length=150,\n",
        "        min_length=30,\n",
        "        do_sample=False\n",
        "    )\n",
        "    return result[0]['summary_text']\n",
        "\n",
        "# Create the Gradio interface\n",
        "iface = gr.Interface(\n",
        "    fn=generate_summary_gradio,\n",
        "    inputs=gr.Textbox(lines=10, label=\"Input Document to Summarize\", placeholder=\"Paste a long news article, report, or text here.\"),\n",
        "    outputs=gr.Textbox(label=\"Generated Abstractive Summary\"),\n",
        "    title=title_text,\n",
        "    description=\"Live demo of the Text Summarization LLM Project using the cnn_dailymail dataset.\",\n",
        "    allow_flagging=\"never\"\n",
        ")\n",
        "\n",
        "# Launch the interface\n",
        "print(\"\\nSegment 4: Launching Gradio Demo...\")\n",
        "iface.launch(share=True)"
