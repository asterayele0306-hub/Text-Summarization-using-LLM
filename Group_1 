        "# --- STEP 2: DATA LOADING AND PREPROCESSING (FIXED) ---\n",
        "\n",
        "# Define model and data parameters\n",
        "model_checkpoint = \"t5-small\"\n",
        "# FIXED: Switching to the highly stable 'cnn_dailymail' dataset to resolve the RuntimeError.\n",
        "DATASET_NAME = \"cnn_dailymail\"\n",
        "DATASET_CONFIG = \"3.0.0\" # Specify a common config to ensure stability\n",
        "\n",
        "# Load the dataset from Hugging Face\n",
        "# NOTE: The load_dataset call now includes the specific config name\n",
        "raw_datasets = load_dataset(DATASET_NAME, DATASET_CONFIG)\n",
        "\n",
        "# Load the T5 Tokenizer\n",
        "tokenizer = AutoTokenizer.from_pretrained(model_checkpoint)\n",
        "\n",
        "# Define T5-specific parameters\n",
        "prefix = \"summarize: \"\n",
        "max_input_length = 512    # Max tokens for the article/document\n",
        "max_target_length = 128   # Max tokens for the summary\n",
        "\n",
        "def preprocess_function(examples):\n",
        "    # FIXED: Update column names for cnn_dailymail dataset\n",
        "\n",
        "    # 1. Add T5 prefix\n",
        "    # Change 'document' to 'article'\n",
        "    inputs = [prefix + doc for doc in examples[\"article\"]]\n",
        "\n",
        "    # 2. Tokenize inputs (documents)\n",
        "    model_inputs = tokenizer(inputs, max_length=max_input_length, truncation=True)\n",
        "\n",
        "    # 3. Tokenize targets (summaries/labels)\n",
        "    # Change 'summary' to 'highlights'\n",
        "    labels = tokenizer(text_target=examples[\"highlights\"], max_length=max_target_length, truncation=True)\n",
        "\n",
        "    model_inputs[\"labels\"] = labels[\"input_ids\"]\n",
        "    return model_inputs\n",
        "\n",
        "# Apply preprocessing to the entire dataset\n",
        "tokenized_datasets = raw_datasets.map(preprocess_function, batched=True)\n",
        "\n",
        "# Select a very small subset for quick, functional training\n",
        "NUM_TRAIN_EXAMPLES = 500\n",
        "NUM_EVAL_EXAMPLES = 50\n",
        "\n",
        "small_train_dataset = tokenized_datasets[\"train\"].shuffle(seed=42).select(range(NUM_TRAIN_EXAMPLES))\n",
        "small_eval_dataset = tokenized_datasets[\"validation\"].shuffle(seed=42).select(range(NUM_EVAL_EXAMPLES))\n",
        "\n",
        "print(f\"\\nSegment 2: Data Preprocessing Complete!\")\n",
        "print(f\"Subset for Training: {len(small_train_dataset)} examples\")\n",
        "print(f\"Subset for Evaluation: {len(small_eval_dataset)} examples\")"
      ],
