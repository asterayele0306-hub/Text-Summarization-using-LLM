        "# --- STEP 3: LLM FINE-TUNING AND EVALUATION SETUP ---\n",
        "\n",
        "# Import DataCollator for sequence to sequence models\n",
        "from transformers import DataCollatorForSeq2Seq\n",
        "\n",
        "# Load the pre-trained T5 model\n",
        "model = AutoModelForSeq2SeqLM.from_pretrained(model_checkpoint)\n",
        "\n",
        "# Load the ROUGE metric\n",
        "metric = evaluate.load(\"rouge\")\n",
        "\n",
        "def compute_metrics(eval_pred):\n",
        "    # Fixed, robust implementation for ROUGE calculation\n",
        "    predictions, labels = eval_pred\n",
        "\n",
        "    # Decode predictions and labels\n",
        "    decoded_preds = tokenizer.batch_decode(predictions, skip_special_tokens=True)\n",
        "\n",
        "    # Replace -100 in labels as these are padding tokens for loss calculation\n",
        "    labels = np.where(labels != -100, labels, tokenizer.pad_token_id)\n",
        "    decoded_labels = tokenizer.batch_decode(labels, skip_special_tokens=True)\n",
        "\n",
        "    # ROUGE requires sentence-level newlines for proper comparison\n",
        "    decoded_preds = [\"\\n\".join(nltk.sent_tokenize(pred.strip())) for pred in decoded_preds]\n",
        "    decoded_labels = [\"\\n\".join(nltk.sent_tokenize(label.strip())) for label in decoded_labels]\n",
        "\n",
        "    # Compute ROUGE scores (rouge1, rouge2, rougeL)\n",
        "    result = metric.compute(predictions=decoded_preds, references=decoded_labels, use_stemmer=True)\n",
        "\n",
        "    # Round the results to 4 decimal places and convert to percentages\n",
        "    result = {k: round(v * 100, 4) for k, v in result.items()}\n",
        "\n",
        "    # Add generated length for monitoring\n",
        "    prediction_lens = [np.count_nonzero(pred != tokenizer.pad_token_id) for pred in predictions]\n",
        "    result[\"gen_len\"] = np.mean(prediction_lens)\n",
        "\n",
        "    return result\n",
        "\n",
        "# Define training arguments (optimized for Colab T4 GPU)\n",
        "OUTPUT_DIR = \"./final_t5_summarizer_project\"\n",
        "\n",
        "training_args = Seq2SeqTrainingArguments(\n",
        "    output_dir=OUTPUT_DIR,\n",
        "    num_train_epochs=3,\n",
        "    per_device_train_batch_size=4,\n",
        "    per_device_eval_batch_size=4,\n",
        "    warmup_steps=100,\n",
        "    weight_decay=0.01,\n",
        "    logging_steps=50,\n",
        "    eval_strategy=\"epoch\",\n",
        "    save_strategy=\"epoch\",\n",
        "    load_best_model_at_end=True,\n",
        "    fp16=True if torch.cuda.is_available() else False,\n",
        "    predict_with_generate=True, # Added to ensure generated tokens are passed to compute_metrics\n",
        "    report_to=\"none\",\n",
        ")\n",
        "\n",
        "# Initialize Data Collator for Seq2Seq\n",
        "data_collator = DataCollatorForSeq2Seq(tokenizer=tokenizer, model=model)\n",
        "\n",
        "# Initialize the Trainer\n",
        "trainer = Seq2SeqTrainer(\n",
        "    model=model,\n",
        "    args=training_args,\n",
        "    train_dataset=small_train_dataset,\n",
        "    eval_dataset=small_eval_dataset,\n",
        "    tokenizer=tokenizer,\n",
        "    data_collator=data_collator, # Explicitly pass the data collator\n",
        "    compute_metrics=compute_metrics\n",
        ")\n",
        "\n",
        "# Start Fine-Tuning\n",
        "print(\"\\nSegment 3: Starting Fine-Tuning...\")\n",
        "trainer.train()\n",
        "\n",
        "# Save the fine-tuned model and tokenizer to a final directory\n",
        "trainer.save_model(OUTPUT_DIR)\n",
        "tokenizer.save_pretrained(OUTPUT_DIR)\n",
        "print(f\"\\nFine-Tuning Complete. Model saved to: {OUTPUT_DIR}\")"
