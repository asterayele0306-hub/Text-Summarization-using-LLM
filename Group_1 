        "# --- STEP 1: SETUP AND INSTALLATIONS ---\n",
        "\n",
        "# Install required libraries\n",
        "!pip install -q transformers datasets accelerate evaluate rouge-score gradio\n",
        "!pip install -q nltk\n",
        "\n",
        "# Ensure you have git-lfs installed for Hugging Face Hub (Optional, but good practice)\n",
        "!apt-get install git-lfs\n",
        "\n",
        "# Import Core Libraries\n",
        "import os\n",
        "import transformers\n",
        "from datasets import load_dataset\n",
        "from transformers import AutoTokenizer, AutoModelForSeq2SeqLM, Seq2SeqTrainingArguments, Seq2SeqTrainer\n",
        "import evaluate\n",
        "import numpy as np\n",
        "import nltk\n",
        "import gradio as gr\n",
        "from huggingface_hub import notebook_login\n",
        "import torch\n",
        "\n",
        "# Download sentence tokenizer for ROUGE evaluation\n",
        "try:\n",
        "    nltk.download('punkt', quiet=True)\n",
        "    print(\"NLTK 'punkt' downloaded.\")\n",
        "except Exception as e:\n",
        "    print(f\"NLTK download failed: {e}\")\n",
        "\n",
        "# Optional: Login to Hugging Face Hub (uncomment and run if you want to upload your model)\n",
        "# notebook_login()\n",
        "\n",
        "print(\"\\nSegment 1: Setup and Imports Complete! (Libraries installed)\")"
      ]
